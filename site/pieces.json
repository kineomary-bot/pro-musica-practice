nal":"original.pdf","lyrics":"Gloria a te, Cristo Gesù\r\n\r\nGloria a te, Cristo Gesù, oggi e sempre tu regnerai!\r\nGloria a te! Presto verrai: sei speranza solo tu!\r\n\r\nSia lode a te! Cristo Signore, offri per noi il dono, \r\nchiedi giustizia: l'anno di grazia apre le porte a te.\r\nSolo in te pace e unità! Amen! Alleluia!\r\n\r\nSia lode a te! Tutta la Chiesa celebra il Padre con la tua voce, \r\ne nello Spirito canta di gioia.\r\nSolo in te pace e unità! Amen! Alleluia!"},{"id":"gloria","title":"Gloria","dir":"audio/gloria/","tagIds":["christmas-2026"],"voices":[{"id":"soprano-1","name":"Soprano 1","startingMidi":74,"startingNote":"D5"},{"id":"soprano-2","name":"Soprano 2","startingMidi":74,"startingNote":"D5"},{"id":"alto","name":"Alto","startingMidi":66,"startingNote":"F#4"},{"id":"tenor","name":"Tenor","startingMidi":57,"startingNote":"A3"},{"id":"bass","name":"Bass","startingMidi":50,"startingNote":"D3"}],"files":{"all":"all.mp3","loud":{"soprano-1":"loud-soprano-1.mp3","soprano-2":"loud-soprano-2.mp3","alto":"loud-alto.mp3","tenor":"loud-tenor.mp3","bass":"loud-bass.mp3"},"only":{"soprano-1":"only-soprano-1.mp3","soprano-2":"only-soprano-2.mp3","alto":"only-alto.mp3","tenor":"only-tenor.mp3","bass":"only-bass.mp3"},"stems":{"soprano-1":"only-soprano-1.mp3","soprano-2":"only-soprano-2.mp3","alto":"only-alto.mp3","tenor":"only-tenor.mp3","bass":"only-bass.mp3"}},"score":"score.pdf","bpm":100,"duration":130.8,"beats":[[0,1],[0.6,0],[1.2,0],[1.8,0],[2.4,1],[3,0],[3.6,0],[4.2,0],[4.8,1],[5.4,0],[6,0],[6.6,0],[7.2,1],[7.8,0],[8.4,0],[9,0],[9.6,1],[10.2,0],[10.8,0],[11.4,0],[12,1],[12.6,0],[13.2,0],[13.8,0],[14.4,1],[15,0],[15.6,0],[16.2,0],[16.8,1],[17.4,0],[18,0],[18.6,0],[19.2,1],[19.8,0],[20.4,0],[21,0],[21.6,1],[22.2,0],[22.8,0],[23.4,0],[24,1],[24.6,0],[25.2,0],[25.8,0],[26.4,1],[27,0],[27.6,0],[28.2,0],[28.8,1],[29.4,0],[30,0],[30.6,0],[31.2,1],[31.8,0],[32.4,0],[33,0],[33.6,1],[34.2,0],[34.8,0],[35.4,0],[36,1],[36.6,0],[37.2,0],[37.8,0],[38.4,1],[39,0