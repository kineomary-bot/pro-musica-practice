ics":"Come Colours Rise\r\n\r\nNeath summer skies this Christmas morn\r\nTo God, our saviour son is born\r\nOur infant nation newly formed\r\nLike Jesus challenged by this dawn\r\nThe Christian family open armed\r\nBy smiling infants doubly charmed\r\nThis day when we are truly blessed\r\nRenews our courage for his test\r\n\r\nCome colours rise\r\nUnder African skies\r\nYizani zintlanga vukani\r\nPhantsi kwezulu le Africa\r\n\r\nCome colours rise\r\nOld fears subside\r\nLet truth and freedom reign\r\n\r\nFrom tabled altar, steepled krans,\r\nkhaya, or where camp-fires dance\r\nFrom fruited valley, field of wheat\r\nIn hut or city let drums beat\r\n\r\nThe messenger of love is here\r\nThe Christ-child whom we do revere\r\nHe come immortal souls to save\r\nFrom sin and everlasting grave\r\n\r\nChrist has come His Will be done\r\nYe-su u-fi-ki-le\r\n\r\nWe thank you mighty God on high\r\nFor mountains sea and radiant sky\r\nFor rivers veldt and fertile earth\r\nBut most of all for sacred birth\r\n\r\nAll praise to him our heavenly king\r\nWith voices hearts and minds we bring\r\nMay joy abound unshackled free\r\nOur rainbow vision ever be"},{"id":"dona-nobis-pacem","title":"Dona Nobis Pacem","dir":"audio/dona-nobis-pacem/","tagIds":["christmas-2026"],"voices":[{"id":"soprano-1","name":"Soprano 1","startingMidi":64,"startingNote":"E4"},{"id":"soprano-2","name":"Soprano 2","startingMidi":64,"startingNote":"E4"},{"id":"alto","name":"Alto","startingMidi":64,"startingNote":"E4"},{"id":"tenor","name":"Tenor","startingMidi":52,"startingNote":"E3"},{"id":"bass","name":"Bass","startingMidi":52,"startingNote":"E3"}],"files":{"all":"all.mp3","loud":{"soprano-1":"loud-soprano-1.mp3","soprano-2":"loud-soprano-2.mp3","alto":"loud-alto.mp3","tenor":"loud-tenor.mp3","bass":"loud-bass.mp3"},"only":{"soprano-1":"only-soprano-1.mp3","soprano-2":"only-soprano-2.mp3","alto":"only-alto.mp3","tenor":"only-tenor.mp3","bass":"only-bass.mp3"},"stems":{"soprano-1":"only-soprano-1.mp3","soprano-2